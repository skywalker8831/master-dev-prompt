# Master Dev Prompt Kit - Environment Variables
# Copy this file to .env and fill in your values

# Required: Anthropic API key for Claude
ANTHROPIC_API_KEY=sk-ant-...

# Optional: API key to protect the FastAPI server
# If set, all requests must include X-Api-Key header
# SERVER_API_KEY=your-secret-key

# Optional: Retry configuration for CLI runner
# MAX_RETRIES=3
# RETRY_DELAY_SECONDS=2
# MASTER_DEV_TIMEOUT_SECONDS=0
